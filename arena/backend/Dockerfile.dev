FROM ghcr.io/astral-sh/uv:python3.12-trixie-slim

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends libcairo2 fonts-liberation curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace/arena/backend

ENV PATH="/workspace/arena/backend/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

COPY domain/pyproject.toml /workspace/domain/pyproject.toml
COPY domain/README.md /workspace/domain/README.md
COPY domain/champion_domain /workspace/domain/champion_domain
COPY arena/backend/pyproject.toml arena/backend/uv.lock ./
RUN uv sync --locked && uv pip install "watchfiles>=1,<2"

COPY arena/backend ./

CMD ["sh", "-c", "uv run alembic upgrade head && uv run python -m src.init_data && exec uv run uvicorn src.main:app --reload --reload-dir /workspace/arena/backend/src --reload-dir /workspace/arena/backend/alembic --reload-dir /workspace/domain/champion_domain --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips='*'"]
