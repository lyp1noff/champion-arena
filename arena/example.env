# Container images
IMAGE_TAG=latest

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
REDIS_PORT=6379

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=champ

# Backend
DEV_MODE=false
LOG_LEVEL=INFO
BACKEND_WORKERS=2
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-value
SERVICE_TOKEN=change-me-to-a-long-random-value

# Cloudflare R2 storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=weur

# Frontend build-time configuration
NEXT_PUBLIC_CDN_URL=https://cdn.example.com
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_ID=

# Cloudflare Tunnel. Required only when the cloudflared service is enabled.
CLOUDFLARE_TUNNEL_TOKEN=
