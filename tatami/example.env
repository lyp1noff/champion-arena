# Container images
IMAGE_TAG=latest

# PostgreSQL
# Use localhost for local backend/sync worker processes. Docker Compose overrides it to db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=champ_local

# Tatami backend
DEV_MODE=false
EDGE_ID=tatami-node-01

# Central Arena API
EXTERNAL_API_URL=http://localhost:8000/api
EXTERNAL_API_TOKEN=change-me

# Sync worker (Tatami -> Arena)
SYNC_INTERVAL_SECONDS=1
SYNC_HTTP_TIMEOUT_SECONDS=15
SYNC_BATCH_SIZE=20
LOG_LEVEL=info
