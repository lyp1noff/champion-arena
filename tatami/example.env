# Container images
IMAGE_TAG=latest

# PostgreSQL
# Use localhost for local backend/outbox processes. Docker Compose overrides it to db.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=champ_local

# Tatami backend
DEV_MODE=false
EDGE_ID=tatami-node-01

# Central Arena API
EXTERNAL_API_URL=http://localhost:8000/api
EXTERNAL_API_TOKEN=change-me

# Outbox worker
PROCESSING_INTERVAL=1s
HTTP_TIMEOUT=10s
BATCH_SIZE=10
LOG_LEVEL=info
